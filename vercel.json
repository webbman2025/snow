{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/christmas/home.html" },
    { "source": "/home.html", "destination": "/christmas/home.html" },
    { "source": "/home2.html", "destination": "/christmas/home2.html" },
    { "source": "/home3.html", "destination": "/christmas/home3.html" },
    { "source": "/christmas", "destination": "/christmas/index.html" },
    { "source": "/christmas/", "destination": "/christmas/index.html" },
    { "source": "/christmas/home", "destination": "/christmas/index.html" },
    { "source": "/christmas/home.html", "destination": "/christmas/index.html" },
    {
      "source": "/media/:path*",
      "destination": "https://www.three.com.hk/media/:path*"
    },
    {
      "source": "/assets/images/:path*",
      "destination": "https://www.three.com.hk/assets/images/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}